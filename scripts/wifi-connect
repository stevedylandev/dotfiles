#!/bin/sh
# Requires: gum, iw, wpa_supplicant, udhcpc, openrc
# Scanning and writing wpa_supplicant.conf both need root.
set -u

CONF=/etc/wpa_supplicant/wpa_supplicant.conf

if [ "$(id -u)" -ne 0 ]; then
    exec doas "$0" "$@"
fi

# Ask the kernel which interfaces are wireless rather than assuming wlan0.
IFACES=$(iw dev | awk '$1 == "Interface" { print $2 }')

case $(printf '%s' "$IFACES" | grep -c .) in
    0) gum style --foreground 196 "No wireless interfaces found."; exit 1 ;;
    1) IFACE=$IFACES ;;
    *) IFACE=$(printf '%s\n' "$IFACES" | gum choose --header "Interface:") ;;
esac

if [ -z "$IFACE" ]; then
    exit 1
fi

ip link set "$IFACE" up 2>/dev/null

SCAN=$(mktemp)
trap 'rm -f "$SCAN"' EXIT INT TERM

# The scan has to run inside the spinner, and into a file — gum spin owns
# stdout while it renders. `scan dump` reuses cached results if the card is
# busy (already associated), which is when a live scan tends to fail.
gum spin --spinner dot --title "Scanning for networks..." -- sh -c '
    iw dev "$1" scan > "$2" 2>/dev/null || iw dev "$1" scan dump > "$2" 2>/dev/null
' _ "$IFACE" "$SCAN"

# Only real SSID lines: bare "SSID: " is a hidden network, and "SSID List"
# under extended capabilities is not a network at all.
SSIDS=$(sed -n 's/^[[:space:]]*SSID: \(..*\)$/\1/p' "$SCAN" | sort -u)

SSID=""
if [ -n "$SSIDS" ]; then
    # Never pipe an empty list into gum filter: with no input it falls back to
    # listing the current directory, which looks like a network list but isn't.
    SSID=$(printf '%s\n' "$SSIDS" | gum filter --placeholder "Select a network...")
else
    gum style --foreground 214 "No networks found on $IFACE — enter one manually."
fi

if [ -z "$SSID" ]; then
    SSID=$(gum input --placeholder "SSID" --prompt "Network name: ")
fi

if [ -z "$SSID" ]; then
    gum style --foreground 196 "No SSID entered, aborting."
    exit 1
fi

PASS=$(gum input --password --placeholder "leave empty for an open network" --prompt "Password: ")

# Build the new config off to the side: a rejected passphrase must not blank
# out the config that is currently working.
NEW=$(mktemp)
trap 'rm -f "$SCAN" "$NEW"' EXIT INT TERM

if [ -z "$PASS" ]; then
    printf 'network={\n\tssid="%s"\n\tkey_mgmt=NONE\n}\n' "$SSID" > "$NEW"
elif ! wpa_passphrase "$SSID" "$PASS" 2>/dev/null | grep -v '^[[:space:]]*#psk=' > "$NEW"; then
    gum style --foreground 196 "Rejected by wpa_passphrase — password must be 8-63 characters."
    exit 1
fi

if [ ! -s "$NEW" ]; then
    gum style --foreground 196 "Could not generate a config for $SSID, aborting."
    exit 1
fi

[ -f "$CONF" ] && cp "$CONF" "$CONF.bak"
cat "$NEW" > "$CONF"
chmod 600 "$CONF"

gum spin --spinner dot --title "Connecting to $SSID..." -- sh -c '
    # wpa_supplicant is a supervised OpenRC service on this host and will not
    # reread its config on its own, so restart it rather than signalling it.
    # This also covers the case where wifi-disable stopped it outright.
    # ifup is no help here: wlan0 has no stanza in /etc/network/interfaces.
    rc-service wpa_supplicant restart >/dev/null 2>&1

    # Give the supplicant time to associate before asking for a lease — a
    # DHCP request sent before association just burns its whole timeout.
    i=0
    while [ "$i" -lt 20 ]; do
        iw dev "$1" link 2>/dev/null | grep -q "^Connected to" && break
        sleep 1
        i=$((i + 1))
    done

    # Replace any DHCP client left over from a previous connect; without this
    # they stack up, one per run, all renewing the same lease.
    PIDFILE=/var/run/udhcpc.$1.pid
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null
        rm -f "$PIDFILE"
    fi
    ip addr flush dev "$1" 2>/dev/null

    # Same invocation ifupdown-ng uses for a dhcp stanza. udhcpc daemonises
    # once it has the lease, so this returns with the address already set.
    udhcpc -b -R -p "$PIDFILE" -i "$1" -x "hostname:$(hostname)" >/dev/null 2>&1
' _ "$IFACE"

if ip addr show "$IFACE" | grep -q "inet "; then
    gum style --foreground 46 --bold "✓ Connected to $SSID on $IFACE"
else
    gum style --foreground 196 --bold "✗ Failed to connect to $SSID"
fi
