#!/bin/sh
# Requires: dmenu, libnotify
# dmenu counterpart of net-menu. Everything here runs as the calling user;
# the individual scripts escalate with doas only for the parts that need it.
set -u

# Launched from a keybinding, PATH may not include this directory — resolve
# the sibling scripts relative to this one instead.
DIR=$(dirname "$0")

menu() { dmenu -c -i "$@"; }

# BusyBox's `ip` has no `-br`, so build the brief view by hand. Each line is
# prefixed with a Nerd Font icon for what that interface is and how it is
# doing: 󰤨/󰤫/󰤭 wireless connected/no lease/down, 󰈀/󰲛 wired up/down.
net_status() {
    for path in /sys/class/net/*; do
        iface=${path##*/}
        [ "$iface" = "lo" ] && continue

        state=$(cat "$path/operstate" 2>/dev/null || echo unknown)
        addrs=$(ip -4 addr show "$iface" 2>/dev/null |
            awk '/inet /{ printf "%s%s", (n++ ? " " : ""), $2 }')

        # Container veths and other virtual links with no address are noise;
        # a virtual interface that does carry one (tailscale0, docker0) is not.
        [ -z "$addrs" ] && [ ! -e "$path/device" ] && continue

        # Tunnels sit at operstate "unknown" for their whole life, so an
        # address is what actually says the link is carrying traffic.
        up=0
        case "$state" in
            up) up=1 ;;
            unknown) [ -n "$addrs" ] && up=1 ;;
        esac

        if [ -d "$path/wireless" ] || [ -e "$path/phy80211" ]; then
            if   [ "$up" -eq 0 ];  then icon="󰤭"
            elif [ -z "$addrs" ];  then icon="󰤫"
            else                        icon="󰤨"
            fi
        else
            if [ "$up" -eq 1 ]; then icon="󰈀"; else icon="󰲛"; fi
        fi

        printf '%s  %-12s %-8s %s\n' "$icon" "$iface" "$state" "$addrs"
    done
}

CHOICE=$(printf '%s\n' \
    "Connect to WiFi" \
    "Disable WiFi" \
    "Connect eth0" \
    "Disable eth0" \
    "Show status" \
    "Quit" | menu -l 6 -p "Network:")

case "$CHOICE" in
    "Connect to WiFi") "$DIR/dm-wifi-connect" ;;
    "Disable WiFi")    "$DIR/dm-wifi-disable" ;;
    "Connect eth0")    "$DIR/dm-eth0-connect" ;;
    "Disable eth0")    "$DIR/dm-eth0-disable" ;;
    "Show status")
        # dmenu is the only display surface we have; the selection is ignored.
        STATUS=$(net_status)
        LINES=$(printf '%s\n' "$STATUS" | grep -c .)
        printf '%s\n' "$STATUS" | menu -l "$LINES" -p "Status:" >/dev/null
        ;;
    *) exit 0 ;;
esac
