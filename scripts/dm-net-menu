#!/bin/sh
# Requires: dmenu, libnotify
# dmenu counterpart of net-menu. Everything here runs as the calling user;
# the individual scripts escalate with doas only for the parts that need it.
set -u

# Launched from a keybinding, PATH may not include this directory — resolve
# the sibling scripts relative to this one instead.
DIR=$(dirname "$0")

menu() { dmenu -c -i "$@"; }

# BusyBox's `ip` has no `-br`, so build the brief view by hand.
net_status() {
    ip -4 addr show | awk '
        function flush() {
            if (iface != "") printf "%-16s %-8s %s\n", iface, state, addrs
        }
        /^[0-9]+: / {
            flush()
            iface = $2; sub(/:$/, "", iface)
            addrs = ""
            state = "DOWN"
            if ($0 ~ /state UP/) state = "UP"
            else if ($0 ~ /state UNKNOWN/) state = "UNKNOWN"
        }
        /^[[:space:]]*inet / { addrs = addrs (addrs ? " " : "") $2 }
        END { flush() }
    '
}

CHOICE=$(printf '%s\n' \
    "Connect to WiFi" \
    "Disable WiFi" \
    "Connect eth0" \
    "Disable eth0" \
    "Show status" \
    "Quit" | menu -l 6 -p "Network:")

case "$CHOICE" in
    "Connect to WiFi") "$DIR/dm-wifi-connect" ;;
    "Disable WiFi")    "$DIR/dm-wifi-disable" ;;
    "Connect eth0")    "$DIR/dm-eth0-connect" ;;
    "Disable eth0")    "$DIR/dm-eth0-disable" ;;
    "Show status")
        # dmenu is the only display surface we have; the selection is ignored.
        STATUS=$(net_status)
        LINES=$(printf '%s\n' "$STATUS" | grep -c .)
        printf '%s\n' "$STATUS" | menu -l "$LINES" -p "Status:" >/dev/null
        ;;
    *) exit 0 ;;
esac
