#!/bin/sh
# Requires: gum, openrc, ifupdown-ng
# Stopping the wpa_supplicant service and downing the link both need root.
set -u

IFACE="${1:-wlan0}"

if [ "$(id -u)" -ne 0 ]; then
    exec doas "$0" "$@"
fi

gum confirm "Disable WiFi on $IFACE?" || exit 0

gum spin --spinner dot --title "Disabling $IFACE..." -- sh -c '
    # wpa_supplicant runs under supervise-daemon (supervisor= in
    # /etc/init.d/wpa_supplicant), which respawns the daemon a couple of
    # seconds after any kill. Stopping the service is what takes the
    # supervisor down with it; pkill only ever kills the child.
    rc-service -s -q wpa_supplicant stop

    # wlan0 has no stanza in /etc/network/interfaces, so ifdown is a no-op on
    # this host and leaves the DHCP client behind. Try it anyway for hosts
    # where the interface *is* configured, then clean up by pidfile.
    ifdown "$1" 2>/dev/null

    PIDFILE=/var/run/udhcpc.$1.pid
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null
        rm -f "$PIDFILE"
    fi

    ip addr flush dev "$1" 2>/dev/null
    ip link set "$1" down
' _ "$IFACE"

gum style --foreground 214 "󰤭  $IFACE disabled"
